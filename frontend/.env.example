# Local development: Django runs separately on port 8000.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: enables the Google sign-in button (public OAuth client ID).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Production same-origin mode (nginx proxies /api and /media):
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
# INTERNAL_API_URL=http://127.0.0.1:8000
