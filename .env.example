# Copy this file to .env before running docker compose.
# Generate real values with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Never commit .env or real provider secrets.

# --- Core -------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
JWT_SECRET=change-me-to-a-different-long-random-value
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,backend
SITE_DOMAIN=localhost

POSTGRES_DB=itpark
POSTGRES_USER=itpark
POSTGRES_PASSWORD=change-me-to-a-strong-database-password

# --- Public URLs (must match the nginx/domain setup) ------------------------
FRONTEND_URL=http://localhost
BACKEND_URL=http://localhost
NEXT_PUBLIC_SITE_URL=http://localhost
# Leave empty for same-origin /api and /media (recommended, keeps cookies same-site).
NEXT_PUBLIC_API_URL=
CORS_ALLOWED_ORIGINS=http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost

# Set these to true only after HTTPS is enabled.
AUTH_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false

# --- Demo data ---------------------------------------------------------------
# Safe to leave false on a real database. seed_demo is idempotent when enabled.
SEED_DEMO=false

# --- Payments -----------------------------------------------------------------
# Sandbox works only when DEBUG=true AND PAYMENT_SANDBOX_ENABLED=true.
PAYMENT_SANDBOX_ENABLED=false
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
UZUM_API_KEY=
UZUM_SERVICE_ID=

# --- Email --------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=IT PARK ACADEMY <noreply@itparkacademy.uz>

# --- Google OAuth -------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public client ID baked into the web build (same value as GOOGLE_CLIENT_ID).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Telegram bot -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ITParkAcademyBot
TELEGRAM_WEBHOOK_SECRET=

# --- Firebase Cloud Messaging -------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_FILE=

# --- Additional payment providers --------------------------------------------
UZUM_MERCHANT_ID=
HUMO_MERCHANT_ID=
HUMO_SECRET_KEY=
UZCARD_MERCHANT_ID=
UZCARD_SECRET_KEY=
GOOGLE_PAY_MERCHANT_ID=
GOOGLE_PAY_GATEWAY=
GOOGLE_PAY_GATEWAY_MERCHANT_ID=
APPLE_PAY_MERCHANT_ID=
